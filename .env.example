# Copy to .env.local and fill in. Never commit the real file.

# OpenAI (server-side only). Check the current OpenAI docs for model IDs.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=

# Shop login PIN (6+ digits) and cookie signing secret (long random string,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SHOP_PIN=
SESSION_SECRET=

APP_URL=http://localhost:3000
